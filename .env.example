# 本番（Render）で設定する環境変数の一覧です。実際の値をここに書かないでください。
# ローカル開発では compose.yaml の environment が使われるので、.env は不要です。

# データベースの接続URL（RenderのInternal Database URLを設定）
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# 本番環境では production を設定
NODE_ENV=production

# CSRF対策に使う秘密の文字列（32文字以上のランダムな値。Renderの「Generate」で作成可）
APP_SECRET=

# （任意）共有URLの先頭部分。例: https://apointo.onrender.com
BASE_URL=
